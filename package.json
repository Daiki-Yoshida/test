{
  "name": "tiny-text-inspector",
  "version": "1.0.0",
  "private": true,
  "description": "A tiny TypeScript CLI that summarizes text without runtime dependencies.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
